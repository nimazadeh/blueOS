# Blue Studio OS — root ignore rules
# (Phase 0: committed as forward-looking foundation; refined in Phase 1 once the
#  Laravel application is scaffolded.)

# --- PHP / Composer (Laravel) ---
/vendor/
composer.phar
composer.lock.orig

# Laravel internals
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/provided/*
.env
.env.backup
.env.production

# --- Node ---
/node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/

# Build output (source maps in dev only)
/public/build/

# --- Media / uploads (runtime data, not source) ---
/public/uploads/*
!/public/uploads/.gitkeep

# --- Tests & tooling ---
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/playwright-report/
/test-results/
/blob-report/
/pw-storage/
.vscode/
.idea/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
