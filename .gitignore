# Blue Studio OS — Laravel + frontend + OS noise

# Dependencies
/vendor/
/node_modules/
.pnp
.pnp.js

# PHP / Laravel
.env
.env.backup
.env.production
.phpunit.cache/
.phpunit.result.cache
.phpstan-cache/
storage/logs/*.log
storage/framework/cache/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/media/*
